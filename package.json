{
  "name": "que-pinta-salta",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace web",
    "build": "turbo run build --filter=web",
    "start": "npm run start --workspace web",
    "lint": "npm run lint --workspace web",
    "typecheck": "turbo run typecheck",
    "test": "npm run test --workspace web",
    "db:types": "npm run db:types --workspace @qps/db",
    "scrape": "npm run scrape --workspace web",
    "dedup:events": "npm run dedup:events --workspace web",
    "dedup:check": "npm run dedup:check --workspace web",
    "e2e": "npm run e2e --workspace web",
    "e2e:list": "npm run e2e:list --workspace web"
  },
  "devDependencies": {
    "supabase": "^2.119.0",
    "turbo": "2.11.7"
  }
}
