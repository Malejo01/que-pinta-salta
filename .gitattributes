# Las migraciones SQL van siempre con LF, en Windows también: un CR de más
# dentro del cuerpo de una función cambia la función, y el CI (Linux) compara
# contra producción byte a byte.
supabase/**/*.sql text eol=lf

# Generado por `npm run db:types`; el CI lo regenera en Linux y lo compara byte a byte.
packages/db/src/database.types.ts text eol=lf

# Scripts de shell: con CRLF bash no los corre.
*.sh text eol=lf
